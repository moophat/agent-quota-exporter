# Example systemd unit. It runs as a dedicated, unprivileged user, created with:
#   useradd --system --no-create-home --shell /usr/sbin/nologin agent-quota-exporter
# Give that user read-only access to the profile dirs it monitors (for example a read-only group). It writes
# nowhere but its state dir (except SQLite's own -shm coordination / rare writer-close sidecar race; see README.md).
# The shipped examples/config.yaml enables only profiles usable by this unprivileged user; /root and other-user
# agy profiles are commented out there as alternatives. If you enable profiles under /root (/root/.claude*), set
# User=root and remove Group=.
#
# With quota.agy_usage on, the exporter runs the agy client inside this unit, as the owner of the agy HOME, which
# requires User=root and removing Group= unless that HOME belongs to agent-quota-exporter:
# - the client must be on this unit's PATH: systemd's default holds only the standard /usr/local and /usr dirs, so
#   set Environment=PATH= to include the client's dir (a per-user install such as ~/.local/bin is not on it);
# - a login refresh rewrites the client's token file in its HOME, which ProtectHome=read-only forbids: add that HOME
#   to ReadWritePaths= (this is the agy client writing its own file, not the exporter);
# - the client can briefly use around 200 MB of memory: raise MemoryMax= to 512M.
[Unit]
Description=agent-quota-exporter (read-only AI agent quota and usage metrics)
After=network-online.target
Wants=network-online.target

[Service]
User=agent-quota-exporter
Group=agent-quota-exporter
# agy_usage only, the dir holding the agy client first:
# Environment=PATH=/home/acct-c/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/agent-quota-exporter --config /etc/agent-quota-exporter/config.yaml
StateDirectory=agent-quota-exporter
StateDirectoryMode=0700
Restart=on-failure
RestartSec=30s
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/agent-quota-exporter
# agy_usage only, the agy HOME (see above):
# ReadWritePaths=/home/acct-c
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryMax=256M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
